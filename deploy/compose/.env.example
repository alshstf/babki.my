# POSTGRES_PASSWORD is interpolated into a connection URL: use only URL-safe
# characters (letters, digits, - _ . ~). Avoid @ / : ? # % and spaces.
POSTGRES_PASSWORD=change-me
BABKI_PORT=8080

# The program's version, as on the releases page without the leading v. latest
# follows each new release on `docker compose pull`; a number such as 0.1.0
# stays on it. Rolling back to an earlier number after the database schema
# has moved on needs the backup taken before the update (see the README).
BABKI_VERSION=latest

# BABKI_ENCRYPTION_KEY encrypts broker API tokens stored in the database (the
# T-Invest connection, and any future importer's token) so a database backup
# does not also hand out a live broker credential. Required: the app refuses
# to start without it. Exactly 64 hex characters (32 bytes, AES-256).
# Generate one with:
#   openssl rand -hex 32
BABKI_ENCRYPTION_KEY=

# The sign-in cookie is HTTPS-only by default: serve the app through an HTTPS
# reverse proxy (see the README). Opening it over plain http from another
# machine, say on a home network, needs this set to false — the sign-in form
# says so when the browser does not keep the session. http://localhost works
# either way.
# BABKI_COOKIE_SECURE=true
# BABKI_LOG_LEVEL=info
# BABKI_LOG_FORMAT=json
