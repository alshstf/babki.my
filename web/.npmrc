# openapi-typescript@7.13.0 (latest published) declares peerDependencies
# typescript "^5.x", but this project pins typescript "~6.0.2" for its newer
# language features. Verified in task 4 that gen:api and build both work
# cleanly against TS 6.0.3; the peer range is just an upstream lag. Without
# this, `npm ci`/`npm install` fail with ERESOLVE (confirmed in task 12).
legacy-peer-deps=true
